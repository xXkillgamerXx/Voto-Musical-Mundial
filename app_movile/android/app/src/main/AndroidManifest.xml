<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Sin anuncios en esta versión: quitamos el ID de publicidad que inyecta
         google_mobile_ads para poder declarar "No usa ID de publicidad" en Play.
         Para activar anuncios en el futuro, elimina esta línea y declara "Sí". -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID"
        tools:node="remove"/>

    <application
        android:label="Music Mundial VOTE"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <!-- AdMob App ID (test). Reemplazar por el ID real de AdMob al publicar. -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-3940256099942544~3347511713"/>
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- App Links: https://vote.musicmundial.com/... abre la app si está instalada -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data
                    android:scheme="https"
                    android:host="vote.musicmundial.com"
                    android:pathPrefix="/votacion"/>
                <data
                    android:scheme="https"
                    android:host="vote.musicmundial.com"
                    android:pathPrefix="/poll"/>
                <data
                    android:scheme="https"
                    android:host="vote.musicmundial.com"
                    android:pathPrefix="/artista"/>
                <data
                    android:scheme="https"
                    android:host="vote.musicmundial.com"
                    android:pathPrefix="/artist"/>
                <data
                    android:scheme="https"
                    android:host="vote.musicmundial.com"
                    android:pathPrefix="/registro"/>
                <data
                    android:scheme="https"
                    android:host="vote.musicmundial.com"
                    android:pathPrefix="/register"/>
                <data
                    android:scheme="https"
                    android:host="vote.musicmundial.com"
                    android:pathPrefix="/noticias"/>
                <data
                    android:scheme="https"
                    android:host="vote.musicmundial.com"
                    android:pathPrefix="/news"/>
                <data
                    android:scheme="https"
                    android:host="vote.musicmundial.com"
                    android:pathPrefix="/misiones"/>
                <data
                    android:scheme="https"
                    android:host="vote.musicmundial.com"
                    android:pathPrefix="/missions"/>
                <data
                    android:scheme="https"
                    android:host="vote.musicmundial.com"
                    android:pathPrefix="/votaciones"/>
                <data
                    android:scheme="https"
                    android:host="vote.musicmundial.com"
                    android:pathPrefix="/polls"/>
                <data
                    android:scheme="https"
                    android:host="vote.musicmundial.com"
                    android:pathPrefix="/artistas"/>
                <data
                    android:scheme="https"
                    android:host="vote.musicmundial.com"
                    android:pathPrefix="/artists"/>
                <data
                    android:scheme="https"
                    android:host="vote.musicmundial.com"
                    android:pathPrefix="/user"/>
                <data
                    android:scheme="https"
                    android:host="www.vote.musicmundial.com"
                    android:pathPrefix="/votacion"/>
            </intent-filter>
            <!-- Scheme propio de respaldo: vmm://votacion/2026/slug -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="vmm"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="vmm_default" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
