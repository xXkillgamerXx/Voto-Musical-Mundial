NODE_ENV=development
PORT=4000
APP_ORIGIN=http://localhost:5174,http://127.0.0.1:5174

DATABASE_URL=postgresql://votomusicamundial:votomusicamundial@localhost:5432/votomusicamundial?schema=public
REDIS_URL=redis://localhost:6379

# Music Mundial news (Laragon MySQL local). Never use vote_db for this.
NEWS_MYSQL_HOST=127.0.0.1
NEWS_MYSQL_PORT=3306
NEWS_MYSQL_USER=root
NEWS_MYSQL_PASSWORD=password
NEWS_MYSQL_DATABASE_ES=musicmundial_es
NEWS_MYSQL_DATABASE_EN=musicmundial_en
# Optional fallback API key for GET /api/news/tags (CRM / article tools).
# Prefer creating keys in admin: /es/admin/api-keys
# Header: X-API-Key: <key>  or  Authorization: Bearer <key>
# Multiple keys allowed, comma-separated.
NEWS_CRM_API_KEY=

JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ANONYMOUS_SECRET=change-me-anonymous-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
JWT_ANONYMOUS_EXPIRES_IN=365d
GOOGLE_CLIENT_ID=927668152816-gko08hdb5upa01a3psav544t0gf9m1a4.apps.googleusercontent.com
# Bundle ID nativo iOS (Sign in with Apple).
APPLE_CLIENT_ID=vote.musicmundial.com

IP_HASH_SALT=change-me-ip-hash-salt
SIGNUP_MAX_PER_IP=3
DEFAULT_ANONYMOUS_COOLDOWN_MINUTES=60
VOTE_SYNC_BATCH_SIZE=1000
VOTE_RATE_LIMIT_USER_PER_MINUTE=3000
VOTE_RATE_LIMIT_IP_PER_MINUTE=30000

# Cloudflare Turnstile (proteccion anti-bots en votos anonimos).
# Deja TURNSTILE_SECRET vacio para desactivar. La clave del sitio va en el frontend (VITE_TURNSTILE_SITE_KEY).
TURNSTILE_SECRET=
TURNSTILE_ENABLED=true

# Moderación de comentarios (OpenAI Moderation API es gratis)
OPENAI_API_KEY=
OPENAI_MODERATION_MODEL=omni-moderation-latest
# openai | local | both
COMMENT_MODERATION_MODE=openai

# Bot de comentarios con IA (DeepSeek u OpenAI-compatible)
# Si COMMENT_BOT_AI_API_KEY está vacío, usa OPENAI_API_KEY.
COMMENT_BOT_AI_API_KEY=
COMMENT_BOT_AI_BASE_URL=https://api.deepseek.com/v1
COMMENT_BOT_AI_MODEL=deepseek-chat
# Detección promo/desvío en comentarios: diccionario local (sin IA). Solo alerta admin.
# Los enlaces externos en comentarios siguen bloqueados.
COMMENT_PROMO_AI=false
# Palabras extra del fallback local (separadas por coma)
COMMENTS_BLOCKED_WORDS=

# PayPal Checkout (Sandbox). Client ID y Secret de developer.paypal.com
# Modo: sandbox | live
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# SMTP BillionMail (mail.musicmundial.com). Vote = auth/votos; Info = sitio/contacto.
SMTP_HOST=mail.musicmundial.com
SMTP_PORT=587
SMTP_USER=vote@musicmundial.com
SMTP_PASS=
MAIL_FROM=Music Mundial Votes <vote@musicmundial.com>
SMTP_INFO_USER=info@musicmundial.com
SMTP_INFO_PASS=
MAIL_FROM_INFO=Music Mundial <info@musicmundial.com>
# Destino del formulario de contacto del sitio (About / Contact / DMCA).
CONTACT_TO=info@musicmundial.com
